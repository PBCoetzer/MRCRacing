[Unit]
Description=MRC private static build and Xneelo deployment worker
After=network-online.target
Wants=network-online.target
OnFailure=hermes-failure-notify@%n.service

[Service]
Type=oneshot
User=mrc-build
Group=mrc-build
WorkingDirectory=/srv/mrc-site/repository
Environment=HOME=/var/lib/mrc-build
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/mrc-site/worker.env
ExecStart=/opt/mrc-build/mrc_build_worker.py
UMask=0077
Nice=10
CPUQuota=60%
MemoryMax=3G
TasksMax=256
TimeoutStartSec=45min
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
LockPersonality=true
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/mrc-site /var/lib/mrc-build
ReadOnlyPaths=/etc/mrc-site
