{
  "name": "mrc-website-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "audit:terminology": "node scripts/audit-public-terminology.mjs",
    "build:static": "npm run audit:terminology && next build && node scripts/prepare-static-export.mjs",
    "build:development": "node --env-file=.env.development.local scripts/build-development.mjs",
    "typecheck": "tsc --noEmit",
    "test:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/auth/*.test.mts src/lib/blog/*.test.mts src/lib/email-marketing-consent.test.mts",
    "test:edge": "deno test --config ../supabase/functions/deno.json --allow-env ../supabase/functions",
    "verify:static": "node scripts/verify-static-export.mjs",
    "verify:development": "node --env-file=.env.development.local scripts/verify-development-export.mjs",
    "verify:local": "npm run lint && npm run typecheck && npm run test:auth && npm run test:edge && npm run build:static && npm run verify:static",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "1.5.3",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "next": "16.3.5",
    "radix-ui": "^1.6.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "deno": "2.9.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
